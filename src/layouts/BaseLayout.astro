---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string;
}

const { lang, title, description, altHref } = Astro.props;
const ui = t(lang);
const site = Astro.site ?? new URL('https://alexliwenhao.github.io');
const canonical = new URL(Astro.url.pathname, site);
const altUrl = new URL(altHref, site);
const hreflangSelf = lang === 'zh' ? 'zh-CN' : 'en';
const hreflangAlt = lang === 'zh' ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={hreflangSelf} href={canonical} />
    <link rel="alternate" hreflang={hreflangAlt} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <meta name="theme-color" content="#08090c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ui.siteTitle} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <Header lang={lang} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
